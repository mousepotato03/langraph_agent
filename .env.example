# Required: set your own key in .env, which is ignored by Git.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Optional: web fallback is unavailable unless BOTH values are configured.
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Omit path overrides to use the repository's data/ and db/.
# DATA_PATH=/absolute/path/to/data
# DB_PATH=/absolute/path/to/db

HOST=127.0.0.1
PORT=7860
SESSION_TTL_SECONDS=3600
MAX_ACTIVE_SESSIONS=100
